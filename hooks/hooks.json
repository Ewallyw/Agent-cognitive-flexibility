{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "hooks": {
    "SessionStart": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PLUGIN_ROOT/scripts/session-start.sh\"",
            "async": false,
            "timeout": 10
          }
        ],
        "description": "Initialize cognitive flexibility state on session start",
        "id": "cf:session:start"
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Write|Edit|Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PLUGIN_ROOT/scripts/pre-tool-check.sh\"",
            "async": true,
            "timeout": 5
          }
        ],
        "description": "Lightweight autonomy check before destructive operations",
        "id": "cf:pre:destructive"
      }
    ],
    "Stop": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PLUGIN_ROOT/scripts/session-stop.sh\"",
            "async": true,
            "timeout": 10
          }
        ],
        "description": "Save cognitive flexibility session state on stop",
        "id": "cf:session:stop"
      }
    ]
  }
}
